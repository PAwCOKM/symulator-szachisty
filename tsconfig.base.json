{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "module": "ESNext", "moduleResolution": "Bundler",
    "resolveJsonModule": true, "strict": true, "noFallthroughCasesInSwitch": true,
    "isolatedModules": true, "verbatimModuleSyntax": true, "esModuleInterop": true,
    "skipLibCheck": true, "noEmit": true
  }
}
